// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANIZER
}

enum EventCategoryEnum {
  MUSIC
  SEMINAR
  TALKSHOW
  SPORTS
  EXHIBITION
}

enum EventStatusEnum {
  DRAFT
  UPCOMING
  ON_STAGE
  ENDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRM
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

enum TicketType {
  PRESALE
  REGULAR
  VIP
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String?
  //googleId              String?         @unique
  avatar        String?
  emailVerified Boolean       @default(false)
  role          Role          @default(CUSTOMER)
  referralCode  String?       @unique
  points        Int?          @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  deletedAt     DateTime?
  accounts      Account[]
  events        Event[]
  transactions  Transaction[]
  reviews       Review[]
  verifications Verification[]
  @@map("user")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Verification {
  id                String   @id @default(uuid())
  token             String   @unique
  expiresAt         DateTime
  userId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
//  @@index([identifier])
  @@map("verification")
}

model Event {
  id          String            @id @default(uuid())
  organizerId String
  organizer   User              @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  title       String
  category    EventCategoryEnum @default(MUSIC)

  startDate DateTime @default(now())
  endDate   DateTime @default(now())

  description     String  @db.Text
  provinceId      String
  provinceName    String
  cityId          String
  cityName        String
  venueMaps       String?
  venueDetail     String
  totalQuotaTiket Int     @default(0)

  ticketType TicketType

  vipQuota       Int
  vipPriceNormal Int
  vipPriceFinal  Int

  regularQuota       Int
  regularPriceNormal Int
  regularPriceFinal  Int

  presaleQuota       Int
  presalePriceNormal Int
  presalePriceFinal  Int

  thumbnailImage String
  coverImages    String[] @default([])
  videoUrl       String?

  eventStatus           EventStatusEnum @default(DRAFT)
  scheduledPublishStart DateTime?
  scheduledPublishEnd   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vouchers     Voucher[]
  transactions Transaction[]
  reviewRating Review[]

  isPresale Boolean @default(false)
  isVip     Boolean @default(false)
  isRegular Boolean @default(false)

  @@map("events")
}

model Voucher {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  code         String       @unique
  discountType DiscountType @default(PERCENTAGE)
  discount     Int
  validStart   DateTime
  validEnd     DateTime
  usedCount    Int          @default(0)
  maxUsage     Int          @default(100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transactions Transaction[]

  @@map("vouchers")
}

model Transaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  voucherId String?
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  status      TransactionStatus @default(WAITING_PAYMENT)
  quantity    Int               @default(1)
  normalPrice Int
  totalPrice  Int
  discPrice   Int
  pointUsed   Int               @default(0)

  paymentProof    String?
  paymentDeadline DateTime
  ConfirmDeadline DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eTickets ETicket[]

  @@map("transactions")
}

model ETicket {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  ticketCode String    @unique
  isAttended Boolean   @default(false)
  attendedAt DateTime?
  qrToken    String    @unique @default(uuid())
  pdfUrl     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reviews Review[]

  @@map("ticketing")
}

model Review {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eTicketId String
  eTicket   ETicket @relation(fields: [eTicketId], references: [id])

  ratingScore      Int
  reviewDesc       String?  @db.Text
  orgReply         String?  @db.Text
  reviewCustomerAt DateTime
  orgReplyAt       DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("reviews")
}
