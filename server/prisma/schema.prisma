// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANIZER
}

enum EventCategory {
  MUSIC
  SEMINAR
  TALKSHOW
  ARTS_THEATRE
  SPORTS
  COMMUNITY
  EXHIBITION
  OTHER
}

enum EventStatus {
  DRAFT
  UPCOMING
  PUBLISHED
  ONGOING
  COMPLETED
  ENDED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TransactionStatus {
  WAITING_PAYMENT
  WAITING_CONFIRM
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String?
  //googleId              String?         @unique
  avatar        String?
  emailVerified Boolean        @default(false)
  role          Role           @default(CUSTOMER)
  referralCode  String         @unique
  points        Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  deletedAt     DateTime?
  accounts      Account[]
  events        Event[]
  transactions  Transaction[]
  reviews       Review[]
  verifications Verification[]

  @@map("user")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Verification {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //  @@index([identifier])
  @@map("verification")
}

model Event {
  id             String        @id @default(uuid())
  organizerId    String
  title          String
  category       EventCategory @default(MUSIC)
  description    String        @db.Text
  eventStartDate DateTime
  eventEndDate   DateTime
  provinceId     String // data diambil dari API Emsifa
  provinceName   String
  cityId         String // data diambil dari API Emsifa
  cityName       String
  venueAddress   String
  venueMapsUrl   String?
  thumbnailImage String
  coverImages    String[] //url cloudinary
  videoUrl       String? // url cloudinary

  eventStatus           EventStatus @default(DRAFT)
  scheduledPublishStart DateTime?
  scheduledPublishEnd   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  vouchers     Voucher[]
  transactions Transaction[]
  reviewRating Review[]
  ticketTypes  TicketType[]
  organizer    User          @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@map("event")
}

model TicketType {
  id             String    @id @default(uuid())
  eventId        String
  name           String
  priceNormal    Int
  priceAnchor    Int? // teknik strikethrough pricing anchoring
  quota          Int
  saleStart      DateTime?
  saleEnd        DateTime?
  createdAt      DateTime @default(now())
  deletedAt      DateTime? 
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("ticket_type")
}

model Voucher {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  code         String       @unique
  discountType DiscountType @default(PERCENTAGE)
  discount     Int
  validStart   DateTime
  validEnd     DateTime
  usedCount    Int          @default(0)
  maxUsage     Int          @default(100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  transactions Transaction[]

  @@map("vouchers")
}

model Transaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  voucherId String?
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  status      TransactionStatus @default(WAITING_PAYMENT)
  quantity    Int               @default(1)
  normalPrice Int
  totalPrice  Int
  discPrice   Int
  pointUsed   Int               @default(0)

  paymentProof    String?
  paymentDeadline DateTime
  ConfirmDeadline DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  eTickets ETicket[]

  @@map("transactions")
}

model ETicket {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  ticketCode String    @unique
  isAttended Boolean   @default(false)
  attendedAt DateTime?
  qrToken    String    @unique @default(uuid())
  pdfUrl     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reviews Review[]

  @@map("ticketing")
}

model Review {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  eTicketId String
  eTicket   ETicket @relation(fields: [eTicketId], references: [id])

  ratingScore      Int
  reviewDesc       String?  @db.Text
  orgReply         String?  @db.Text
  reviewCustomerAt DateTime
  orgReplyAt       DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("reviews")
}
